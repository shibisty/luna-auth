{
  "info": {
    "_postman_id": "ff20a0c5-f330-51dc-a998-1f53b213fbe6",
    "name": "Luna Auth API",
    "description": "The public API of luna-auth (docs/openapi.yaml). Set `apiKey` to a server key with `auth:login` and, for Data and Admin, `adminKey` to a server key with `auth:users.read`, `auth:users.write`, `auth:data.read` and `auth:data.write` (both from the Luna dashboard). Run the folders in order: Users saves the tokens the next requests use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "adminKey",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": "secret-password"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ping (which application is my key)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "ping"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"app_id\", () => pm.expect(pm.response.json().app_id).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "users"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// a new user on every run",
                  "const n = Date.now().toString(36);",
                  "pm.collectionVariables.set(\"email\", `ann.${n}@example.com`);",
                  "pm.collectionVariables.set(\"username\", `ann_${n}`);",
                  "pm.collectionVariables.set(\"password\", \"secret-password\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"tokens\", () => { pm.expect(body.access_token).to.be.a(\"string\"); pm.expect(body.refresh_token).to.be.a(\"string\"); pm.expect(body.token_type).to.eql(\"Bearer\"); });",
                  "pm.collectionVariables.set(\"accessToken\", body.access_token);",
                  "pm.collectionVariables.set(\"refreshToken\", body.refresh_token);",
                  "if (body.user) pm.collectionVariables.set(\"userId\", body.user.id);",
                  "pm.test(\"user\", () => pm.expect(body.user.email).to.eql(pm.collectionVariables.get(\"email\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in by email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sessions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"tokens\", () => { pm.expect(body.access_token).to.be.a(\"string\"); pm.expect(body.refresh_token).to.be.a(\"string\"); pm.expect(body.token_type).to.eql(\"Bearer\"); });",
                  "pm.collectionVariables.set(\"accessToken\", body.access_token);",
                  "pm.collectionVariables.set(\"refreshToken\", body.refresh_token);",
                  "if (body.user) pm.collectionVariables.set(\"userId\", body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in by username",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sessions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"tokens\", () => { pm.expect(body.access_token).to.be.a(\"string\"); pm.expect(body.refresh_token).to.be.a(\"string\"); pm.expect(body.token_type).to.eql(\"Bearer\"); });",
                  "pm.collectionVariables.set(\"accessToken\", body.access_token);",
                  "pm.collectionVariables.set(\"refreshToken\", body.refresh_token);",
                  "if (body.user) pm.collectionVariables.set(\"userId\", body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in with a wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sessions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same user\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"userId\")));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tokens",
      "item": [
        {
          "name": "Verify the access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tokens/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tokens",
                "verify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{accessToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"active\", () => pm.expect(pm.response.json().active).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tokens/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tokens",
                "refresh"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"spentRefreshToken\", pm.collectionVariables.get(\"refreshToken\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"tokens\", () => { pm.expect(body.access_token).to.be.a(\"string\"); pm.expect(body.refresh_token).to.be.a(\"string\"); pm.expect(body.token_type).to.eql(\"Bearer\"); });",
                  "pm.collectionVariables.set(\"accessToken\", body.access_token);",
                  "pm.collectionVariables.set(\"refreshToken\", body.refresh_token);",
                  "if (body.user) pm.collectionVariables.set(\"userId\", body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh with the spent token (ends the login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tokens/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tokens",
                "refresh"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{spentRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sessions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"tokens\", () => { pm.expect(body.access_token).to.be.a(\"string\"); pm.expect(body.refresh_token).to.be.a(\"string\"); pm.expect(body.token_type).to.eql(\"Bearer\"); });",
                  "pm.collectionVariables.set(\"accessToken\", body.access_token);",
                  "pm.collectionVariables.set(\"refreshToken\", body.refresh_token);",
                  "if (body.user) pm.collectionVariables.set(\"userId\", body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tokens/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tokens",
                "revoke"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh after logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tokens/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tokens",
                "refresh"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Password",
      "item": [
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/password/forgot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "password",
                "forgot"
              ]
            },
            "description": "Emails a reset link (or logs it without MAIL_HOST); 409 when the application has no password reset URL in the dashboard.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 or 409 (no reset URL)\", () => pm.expect(pm.response.code).to.be.oneOf([202, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "password",
                "reset"
              ]
            },
            "description": "Set `resetToken` to the `token` of the emailed link first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"new-secret-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get(\"resetToken\")) { pm.test(\"status 204\", () => pm.response.to.have.status(204)); pm.collectionVariables.set(\"password\", \"new-secret-password\"); } else { pm.test(\"422 without a token\", () => pm.response.to.have.status(422)); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Data",
      "description": "The application's data about a user: string values by key. `adminKey` needs `auth:data.read` and `auth:data.write`.",
      "item": [
        {
          "name": "Set a value (new key)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}/data/plan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "users",
                "{{userId}}",
                "data",
                "plan"
              ]
            },
            "description": "Scope `auth:data.write`. 201 for a new key, 200 for a changed one.",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{adminKey}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": \"pro\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"value\", () => pm.expect(pm.response.json().value).to.eql(\"pro\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set several, delete with null",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}/data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "users",
                "{{userId}}",
                "data"
              ]
            },
            "description": "All or nothing.",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{adminKey}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"plan\": \"team\",\n    \"profile.city\": \"Kyiv\",\n    \"old.flag\": null\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"data\", () => pm.expect(pm.response.json().data).to.eql({\"plan\": \"team\", \"profile.city\": \"Kyiv\"}));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the user's data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}/data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "users",
                "{{userId}}",
                "data"
              ]
            },
            "description": "Scope `auth:data.read`.",
            "auth": {
              "type": "apikey",
              "apikey": [
