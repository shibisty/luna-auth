APP_NAME=luna-auth
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8081
HTTP_ADDR=:8081
LOG_LEVEL=debug
# Swagger UI at /docs (the OpenAPI document is always at /openapi.yaml).
API_DOCS=true

# Behind nginx: the networks nginx connects from (CIDRs, addresses, "private", "loopback").
# HTTP_TRUSTED_PROXIES=172.18.0.0/16

DB_DRIVER=postgres
DATABASE_DSN=postgres://auth_service:auth_password@127.0.0.1:5433/auth_db?sslmode=require
# Run pending migrations at start (handy locally; use `go run . migrate` in production).
DB_MIGRATE=true

# End users' tokens: a random secret of at least 32 bytes (e.g. `openssl rand -base64 48`).
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=15m
AUTH_REFRESH_TTL=720h

# Password reset emails. Without MAIL_HOST they are only written to the log (local only).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Luna <no-reply@luna.local>

# The dashboard checks API keys: its internal address and this service's token
# (one of the dashboard's LUNA_SERVICE_TOKENS).
LUNA_DASHBOARD_URL=http://localhost:8080
LUNA_DASHBOARD_TOKEN=
